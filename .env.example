# Password you type to open the app. Required before WHOOP can be connected.
APP_PASSWORD=

# From your app in the WHOOP Developer Dashboard (https://developer-dashboard.whoop.com).
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=

# Storage (Upstash Redis). On Vercel these are filled in for you when you add the store.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: a long random string, only needed for the Apple Watch shortcut.
INGEST_TOKEN=

# Optional: the public address of the app, if it differs from the one requests arrive on.
APP_URL=
