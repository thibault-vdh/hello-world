# ---------------------------------------------------------------------------
# Deepfake call demo · copy to .env.local and fill in. Never commit real values.
# ---------------------------------------------------------------------------

# Public URL of this app (your ngrok https URL when testing calls/SMS).
# Used for the SMS confirm link and for Twilio webhooks + <Play> audio URLs.
APP_BASE_URL=https://your-subdomain.ngrok-free.app

# 32+ random chars. Signs session cookies, SMS links, audio URLs, webhook URLs,
# and keys the phone-number hashes. Generate: openssl rand -hex 32
LINK_SIGNING_SECRET=

# --- ElevenLabs ------------------------------------------------------------
# Needs: Speech to Text, Voices (write), Text to Speech permissions.
ELEVENLABS_API_KEY=
# Optional overrides
# ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
# ELEVENLABS_REVEAL_VOICE_ID=        # premade voice for the reveal; default is Twilio <Say>
# STT_LANGUAGE=en

# --- Twilio ----------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# E.164 Twilio number with SMS + Voice capability
TWILIO_FROM_NUMBER=+15551234567
# TWILIO_REVEAL_VOICE=Polly.Joanna-Neural

# --- Safeguards ------------------------------------------------------------
# PROTOTYPE MODE (default ON): only these E.164 numbers can be texted or called.
PROTOTYPE_MODE=true
ALLOWED_NUMBERS=+32470123456,+31612345678
# ISO regions and/or calling codes. Everything else is refused.
ALLOWED_COUNTRY_CODES=BE,NL,FR,DE,GB,IE,US,CA
# Minimum seconds of recorded voice before cloning (ElevenLabs needs >= 10).
# MIN_SAMPLE_SECONDS=12

# --- Cloudflare Turnstile (invisible captcha) ------------------------------
# Test keys that always pass: site 1x00000000000000000000BB / secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Local development -----------------------------------------------------
# Fake ElevenLabs + Twilio so the whole flow can be clicked through without keys.
MOCK_PROVIDERS=false
# MOCK_CALL_OUTCOME=no-answer      # first mock call goes unanswered (test retry)
